# Copy this file to .env and change the values before running.
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=0
NODE_ENV=development
ADMIN_USERNAME=admin
# Replace this with a long, unique password before running.
ADMIN_PASSWORD=change-this-password-before-running
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_FILE=./data/reservations.sqlite
